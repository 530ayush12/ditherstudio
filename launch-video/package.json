{
  "name": "dither-skill-launch-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "music": "node scripts/generate-launch-audio.mjs",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts LaunchVideo --frame=180 --output=out/still-180.png",
    "contact": "node scripts/contact-sheet.mjs",
    "render": "npm run music && remotion render src/index.ts LaunchVideo out/dither-skill-launch.mp4 --codec=h264 --audio-codec=aac"
  },
  "dependencies": {
    "@remotion/cli": "4.0.489",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.7.3"
  }
}
