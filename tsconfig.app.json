{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/lib/dither.ts",
    "src/lib/browser.ts",
    "src/lib/presets.ts",
    "src/hooks/useDitherWorker.ts",
    "src/workers/dither.worker.ts",
    "src/lib/generate.ts",
    "src/components/GeneratePanel.tsx",
    "src/index.css"
  ],
  "exclude": ["src/cli.ts", "src/server.ts", "src/index.ts", "src/lib/node.ts"]
}
